      "check": [
        "scripts/update_platform_status.py",
        "--check"
      ],
      "write": [
        "scripts/update_platform_status.py",
        "--write"
      ],
      "write_with_database": null,
      "write_policy": "automatic"
    },
    {
      "id": "architecture-audit",
      "depends_on": [
        "capability-evidence",
        "compiler-corpus-coverage",
        "continuous-effect-performance",
        "platform-status"
      ],
      "outputs": [
        "coverage/architecture-audit.json",
        "docs/ARCHITECTURE_DEBT_STATUS.md",
        "docs/COMPILER_COVERAGE_STATUS.md"
      ],
      "check": [
        "scripts/update_architecture_audit.py",
        "--check"
      ],
      "write": [
        "scripts/update_architecture_audit.py",
        "--write"
      ],
      "write_with_database": null,
      "write_policy": "automatic"
    },
    {
      "id": "reusable-pieces",
      "depends_on": [
        "architecture-audit",
        "card-unlock-frontier",
        "capability-evidence",
        "platform-status"
      ],
      "outputs": [
        "coverage/reusable-piece-matrix.json.gz",
        "coverage/reusable-piece-matrix.md",
        "coverage/reusable-piece-card-index.json.gz",
        "coverage/reusable-piece-interactions.json.gz",
        "coverage/reusable-piece-delta.json",
        "coverage/reusable-piece-delta.md",
        "coverage/complex-card-composition.json",
        "coverage/complex-card-composition.md",
        "coverage/program-baseline.json"
      ],
      "check": [
        "scripts/update_reusable_piece_matrix.py",
        "--check"
      ],
      "write": [
        "scripts/update_reusable_piece_matrix.py",
        "--refresh-derived"
      ],
      "write_with_database": [
        "scripts/update_reusable_piece_matrix.py",
        "--write",
        "--db",
        "{db}"
      ],
      "write_policy": "database"
    }
