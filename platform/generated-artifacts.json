      "check": [
        "scripts/update_rules_scheduler.py",
        "--check"
      ],
      "write": [
        "scripts/update_rules_scheduler.py",
        "--write"
      ],
      "write_with_database": null,
      "write_policy": "automatic"
    },
    {
      "id": "module-classifications",
      "depends_on": [],
      "outputs": [
        "platform/module-classifications.json"
      ],
      "check": [
        "scripts/update_module_classifications.py",
        "--check"
      ],
      "write": [
        "scripts/update_module_classifications.py",
        "--write"
      ],
      "write_with_database": null,
      "write_policy": "automatic"
    },
    {
      "id": "continuous-effect-performance",
      "depends_on": [],
      "outputs": [
        "platform/continuous-effect-performance-baseline.json"
      ],
      "check": [
        "scripts/benchmark_continuous_effects.py",
        "--check"
      ],
      "write": [
        "scripts/benchmark_continuous_effects.py",
        "--write"
      ],
      "write_with_database": null,
      "write_policy": "manual"
    },
    {
      "id": "platform-status",
      "depends_on": [
        "compiler-corpus-coverage",
        "rules-derived"
      ],
      "outputs": [
        "coverage/platform-readiness.json",
        "coverage/platform-readiness.md",
        "docs/PLATFORM_IMPLEMENTATION_STATUS.md"
