{
  "schema_version": 1,
  "generators": [
    {
      "id": "capability-evidence",
      "depends_on": [],
      "outputs": [
        "quorune/rules/capability-evidence.json"
      ],
      "check": [
        "scripts/update_capability_evidence.py",
        "--check"
      ],
      "write": [
        "scripts/update_capability_evidence.py",
        "--write"
      ],
      "write_with_database": null,
      "write_policy": "automatic"
    },
    {
      "id": "compiler-corpus-coverage",
      "depends_on": [
        "capability-evidence"
      ],
      "outputs": [
        "coverage/oracle-coverage.json",
        "coverage/oracle-coverage-commander.json",
        "coverage/card-program-coverage.json",
        "coverage/card-program-coverage-commander.json"
      ],
      "check": [
        "scripts/update_compiler_corpus_coverage.py",
        "--check"
      ],
      "write": null,
      "write_with_database": [
        "scripts/update_compiler_corpus_coverage.py",
        "--write",
        "--db",
        "{db}"
      ],
      "write_policy": "database"
    },
    {
      "id": "rules-derived",
      "depends_on": [],
      "outputs": [
        "rules/conformance-cases.json",
        "rules/manifest.json",
        "mechanics/registry.json",
        "coverage/mechanics-coverage.json",
        "coverage/mechanics-coverage.md",
        "coverage/rules-conformance.json",
        "coverage/rules-conformance.md",
        "coverage/rules-coverage.json",
        "coverage/rules-coverage.md"
      ],
      "check": [
        "scripts/update_rules_derived.py",
        "--check"
      ],
      "write": [
        "scripts/update_rules_derived.py",
        "--write"
      ],
      "write_with_database": null,
      "write_policy": "automatic"
    },
    {
      "id": "card-unlock-frontier",
      "depends_on": [
        "compiler-corpus-coverage"
      ],
      "outputs": [
        "coverage/card-unlock-frontier.json.gz",
        "coverage/card-unlock-frontier.md"
      ],
      "check": [
        "scripts/update_card_unlock_frontier.py",
        "--check"
      ],
      "write": null,
      "write_with_database": [
        "scripts/update_card_unlock_frontier.py",
        "--write",
        "--db",
        "{db}"
      ],
      "write_policy": "database"
    },
    {
      "id": "ci-escape-report",
      "depends_on": [],
      "outputs": [
        "coverage/ci-escape-report.json",
        "coverage/ci-escape-report.md"
      ],
      "check": [
        "scripts/update_ci_escape_report.py",
        "--check"
      ],
      "write": [
        "scripts/update_ci_escape_report.py",
        "--write"
      ],
      "write_with_database": null,
      "write_policy": "automatic"
    },
    {
